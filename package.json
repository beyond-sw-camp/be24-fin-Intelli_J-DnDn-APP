{
  "name": "site-access-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8081",
    "dev:web": "vite --host 0.0.0.0 --port 8081",
    "preview:phone": "node scripts/serve-phone-preview.mjs",
    "build": "vite build",
    "build:web": "vite build",
    "build:native": "cross-env VITE_BUILD_FOR_NATIVE=true vite build",
    "check": "node scripts/check-js-syntax.mjs",
    "lint": "eslint src scripts vite.config.js",
    "format": "prettier --write .",
    "cap:sync": "corepack pnpm build:web && npx cap sync",
    "android": "pnpm run build:native && npx cap sync android && npx cap open android",
    "ios": "pnpm run build:native && npx cap sync ios && npx cap open ios",
    "qr": "node scripts/generate_qr.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@ionic/vue": "^8.0.0",
    "@ionic/vue-router": "^8.0.0",
    "ionicons": "^8.0.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@eslint/js": "^9.39.2",
    "@vitejs/plugin-vue": "^6.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "^10.6.0",
    "prettier": "^3.7.4",
    "vite": "^7.0.0",
    "vue-eslint-parser": "^10.2.0"
  },
  "packageManager": "pnpm@9.12.0"
}
